<?xml version="1.0"?>
<robot name="planetary_rover">

  <!-- materials -->
  <material name="gold">
    <color rgba="0.85 0.65 0.12 1.0"/>
  </material>

  <material name="rover_grey">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

  <material name="wheel_dark">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <material name="sensor_red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>

  <material name="sensor_blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>

  <!-- base_footprint (massless root link) -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- base_link (chassis with mesh) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://05_planetary_rover/meshes/chassis.stl"/>
      </geometry>
      <material name="gold"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.3 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="15.0"/>
      <inertia ixx="0.14" ixy="0.0" ixz="0.0" iyy="0.34" iyz="0.0" izz="0.42"/>
    </inertial>
  </link>

  <!-- ================= LEFT ROCKER-BOGIE ================= -->
  <!-- left rocker pivot -->
  <joint name="left_rocker_joint" type="revolute">
    <parent link="base_link"/>
    <child link="left_rocker_link"/>
    <origin xyz="0 0.20 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.35" upper="0.35" effort="50.0" velocity="1.0"/>
  </joint>

  <link name="left_rocker_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.04 0.04"/>
      </geometry>
      <material name="rover_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.04 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.0004" ixy="0.0" ixz="0.0" iyy="0.015" iyz="0.0" izz="0.015"/>
    </inertial>
  </link>

  <!-- left front wheel -->
  <joint name="left_front_wheel_joint" type="continuous">
    <parent link="left_rocker_link"/>
    <child link="left_front_wheel_link"/>
    <origin xyz="0.22 0.05 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="left_front_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0028" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.0028"/>
    </inertial>
  </link>

  <!-- left bogie pivot on rear of rocker -->
  <joint name="left_bogie_joint" type="revolute">
    <parent link="left_rocker_link"/>
    <child link="left_bogie_link"/>
    <origin xyz="-0.15 0.02 -0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.35" upper="0.35" effort="30.0" velocity="1.0"/>
  </joint>

  <link name="left_bogie_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.03 0.03"/>
      </geometry>
      <material name="rover_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.03 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.00015" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.005"/>
    </inertial>
  </link>

  <!-- left middle wheel -->
  <joint name="left_middle_wheel_joint" type="continuous">
    <parent link="left_bogie_link"/>
    <child link="left_middle_wheel_link"/>
    <origin xyz="0.10 0.03 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="left_middle_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0028" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.0028"/>
    </inertial>
  </link>

  <!-- left rear wheel -->
  <joint name="left_rear_wheel_joint" type="continuous">
    <parent link="left_bogie_link"/>
    <child link="left_rear_wheel_link"/>
    <origin xyz="-0.10 0.03 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="left_rear_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0028" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.0028"/>
    </inertial>
  </link>

  <!-- ================= RIGHT ROCKER-BOGIE ================= -->
  <!-- right rocker pivot -->
  <joint name="right_rocker_joint" type="revolute">
    <parent link="base_link"/>
    <child link="right_rocker_link"/>
    <origin xyz="0 -0.20 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.35" upper="0.35" effort="50.0" velocity="1.0"/>
  </joint>

  <link name="right_rocker_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.04 0.04"/>
      </geometry>
      <material name="rover_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.04 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.0004" ixy="0.0" ixz="0.0" iyy="0.015" iyz="0.0" izz="0.015"/>
    </inertial>
  </link>

  <!-- right front wheel -->
  <joint name="right_front_wheel_joint" type="continuous">
    <parent link="right_rocker_link"/>
    <child link="right_front_wheel_link"/>
    <origin xyz="0.22 -0.05 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_front_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0028" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.0028"/>
    </inertial>
  </link>

  <!-- right bogie pivot -->
  <joint name="right_bogie_joint" type="revolute">
    <parent link="right_rocker_link"/>
    <child link="right_bogie_link"/>
    <origin xyz="-0.15 -0.02 -0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.35" upper="0.35" effort="30.0" velocity="1.0"/>
  </joint>

  <link name="right_bogie_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.03 0.03"/>
      </geometry>
      <material name="rover_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.03 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.00015" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.005"/>
    </inertial>
  </link>

  <!-- right middle wheel -->
  <joint name="right_middle_wheel_joint" type="continuous">
    <parent link="right_bogie_link"/>
    <child link="right_middle_wheel_link"/>
    <origin xyz="0.10 -0.03 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_middle_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0028" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.0028"/>
    </inertial>
  </link>

  <!-- right rear wheel -->
  <joint name="right_rear_wheel_joint" type="continuous">
    <parent link="right_bogie_link"/>
    <child link="right_rear_wheel_link"/>
    <origin xyz="-0.10 -0.03 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_rear_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0028" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.0028"/>
    </inertial>
  </link>

  <!-- ================= SENSORS ================= -->
  <!-- camera mast & sensor -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.2 0.0 0.25" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.1 0.05"/>
      </geometry>
      <material name="sensor_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.1 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0002"/>
    </inertial>
  </link>

  <!-- lidar sensor -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0.0 0.18" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.06"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.00036" ixy="0.0" ixz="0.0" iyy="0.00036" iyz="0.0" izz="0.00054"/>
    </inertial>
  </link>

  <!-- imu sensor -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.02" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
      <material name="sensor_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- ================= GAZEBO FRICTION EXTENSIONS ================= -->
  <gazebo reference="left_front_wheel_link">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
  <gazebo reference="left_middle_wheel_link">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
  <gazebo reference="left_rear_wheel_link">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
  <gazebo reference="right_front_wheel_link">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
  <gazebo reference="right_middle_wheel_link">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
  <gazebo reference="right_rear_wheel_link">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

</robot>
